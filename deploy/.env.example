# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# Public hostname, no scheme or trailing slash (e.g. n8n.example.com)
N8N_HOST=
# Generate once with `openssl rand -hex 32` and keep it — losing it makes
# stored credentials unreadable
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/Prague

# Email for Let's Encrypt certificate notices
ACME_EMAIL=
